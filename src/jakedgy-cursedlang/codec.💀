        damn []Event{}
    }
    hpos = 4

    sus event_count normie = (normie)(slay_decode_varint(header, &hpos))

    // Read type dictionary
    sus type_count normie = (normie)(slay_decode_varint(header, &hpos))
    sus types tea[]
    bestie i := 0; i < type_count; i++ {
        sus start normie = hpos
        bestie (header[hpos] != 0) {
            hpos = hpos + 1
        }
        append(types, stringz.from_bytes(header[start:hpos]))
        hpos = hpos + 1 // skip null
    }

    // Read name dictionary
    sus name_count normie = (normie)(slay_decode_varint(header, &hpos))
    sus names tea[]
    bestie i := 0; i < name_count; i++ {
        sus start normie = hpos
        bestie (header[hpos] != 0) {
            hpos = hpos + 1
        }
        append(names, stringz.from_bytes(header[start:hpos]))
        hpos = hpos + 1
    }

    // Read repo ID dictionary
    sus repo_count normie = (normie)(slay_decode_varint(header, &hpos))
    sus repo_ids thicc[] = arrayz.make_thicc(repo_count)
    sus prev_id thicc = 0
    bestie i := 0; i < repo_count; i++ {
        sus delta thicc = slay_decode_varint(header, &hpos)
        repo_ids[i] = prev_id + delta
        prev_id = repo_ids[i]
    }

    // Read name indices per repo ID
    sus name_indices_per_id normie[][]
    bestie i := 0; i < repo_count; i++ {
        sus first_val thicc = slay_decode_varint(header, &hpos)
        ready (first_val == 0) {
            // Multi-name repo
            sus variant_count normie = (normie)(slay_decode_varint(header, &hpos))
            sus ni normie[] = arrayz.make_normie(variant_count)
            bestie j := 0; j < variant_count; j++ {
                ni[j] = (normie)(slay_decode_varint(header, &hpos))
            }
            append(name_indices_per_id, ni)
        } otherwise {
            // Single-name repo (first_val is name_idx + 1)
            sus ni normie[] = [(normie)(first_val - 1)]
            append(name_indices_per_id, ni)
        }
    }

    sus num_groups normie = (normie)(slay_decode_varint(header, &hpos))

    sus events Event[]

    // Process row groups
    bestie group_idx := 0; group_idx < num_groups; group_idx++ {
        sus min_id thicc = slay_decode_varint(bytes, &pos)
        sus min_ts thicc = slay_decode_varint(bytes, &pos)
        sus row_count normie = (normie)(slay_decode_varint(bytes, &pos))

        // Read column sizes
        sus types_len normie = (normie)(slay_decode_varint(bytes, &pos))
        sus repo_idx_len normie = (normie)(slay_decode_varint(bytes, &pos))
        sus variant_idx_len normie = (normie)(slay_decode_varint(bytes, &pos))
        sus ids_len normie = (normie)(slay_decode_varint(bytes, &pos))
        sus ts_len normie = (normie)(slay_decode_varint(bytes, &pos))

        // Read and decompress columns
        sus types_decompressed byte[] = compression.zstd_decompress(bytes[pos:pos + types_len])
        pos = pos + types_len

        sus repo_idx_decompressed byte[] = compression.zstd_decompress(bytes[pos:pos + repo_idx_len])
        pos = pos + repo_idx_len

        sus variant_idx_decompressed byte[] = compression.zstd_decompress(bytes[pos:pos + variant_idx_len])
        pos = pos + variant_idx_len

        sus ids_decompressed byte[] = compression.zstd_decompress(bytes[pos:pos + ids_len])
        pos = pos + ids_len

        sus ts_decompressed byte[] = compression.zstd_decompress(bytes[pos:pos + ts_len])
        pos = pos + ts_len

        // Unpack columns
        sus type_indices thicc[] = unpack_bits_slay(types_decompressed, row_count)
        sus repo_idx_values thicc[] = unpack_bits_slay(repo_idx_decompressed, row_count)
        sus variant_indices thicc[] = unpack_bits_slay(variant_idx_decompressed, row_count)
        sus id_deltas thicc[] = decode_id_deltas_slay(ids_decompressed)
        sus ts_deltas thicc[] = decode_ts_deltas_slay(ts_decompressed)

        // Reconstruct IDs
        sus id_offsets thicc[] = arrayz.make_thicc(row_count)
        ready (row_count > 0) {
            sus cur thicc = zigzag_unslay(id_deltas[0])
            id_offsets[0] = cur
            bestie i := 1; i < row_count; i++ {
                cur = cur + zigzag_unslay(id_deltas[i])
                id_offsets[i] = cur
            }
        }

        // Reconstruct timestamps
        sus ts_offsets thicc[] = arrayz.make_thicc(row_count)
        ready (row_count > 0) {
            sus cur_ts thicc = ts_deltas[0]
            ts_offsets[0] = cur_ts
            bestie i := 1; i < row_count; i++ {
                cur_ts = cur_ts + ts_deltas[i]
                ts_offsets[i] = cur_ts
            }
        }

        // Create events
        bestie i := 0; i < row_count; i++ {
            sus type_idx normie = (normie)(type_indices[i])
            sus repo_idx normie = (normie)(repo_idx_values[i])
            sus variant_idx normie = (normie)(variant_indices[i])
            sus event_id thicc = min_id + id_offsets[i]
            sus timestamp thicc = min_ts + ts_offsets[i]

            sus repo_id thicc = repo_ids[repo_idx]
            sus name_idx normie = name_indices_per_id[repo_idx][variant_idx]
            sus repo_name tea = names[name_idx]
            sus repo_url tea = stringz.sprintf("https://api.github.com/repos/%s", repo_name)

            sus event Event
            event.id = stringz.sprintf("%d", event_id)
            event.event_type = types[type_idx]
            event.repo_id = repo_id
            event.repo_name = repo_name
            event.repo_url = repo_url
            event.created_at = format_timestamp_slay(timestamp)

            append(events, event)
        }
    }

    // Sort by (id, event_type) as required
    arrayz.sort_events_by_key(events)

    damn events
}

// ============================================================================
// OUTPUT JSON - spilling the tea back out bestie
// ============================================================================

slay output_events_json(writer ඞio.SlayWriter, events Event[]) {
    bestie i := 0; i < len(events); i++ {
        sus e Event = events[i]
        sus line tea = stringz.sprintf("{\"id\":\"%s\",\"type\":\"%s\",\"repo\":{\"id\":%d,\"name\":\"%s\",\"url\":\"%s\"},\"created_at\":\"%s\"}\n",
            e.id, e.event_type, e.repo_id, e.repo_name, e.repo_url, e.created_at)
        writer.write_string(line)
    }
}

// ============================================================================
// MAIN - where the vibes come together no cap
// ============================================================================

slay main_character() {
    sus args tea[] = io.get_args()

    ready (len(args) != 2) {
        vibez.spill("Usage: codec <encode|decode>")
        io.exit(1)
    }

    sus command tea = args[1]

    ready (command == "encode") {
        // Read all input from stdin
        sus input tea = io.read_all_stdin()

        // Parse events
        sus events Event[] = parse_json_events(input)

        // Encode - let's get this compression bread
        sus compressed byte[] = slay_encode(events)

        // Write to stdout
        io.write_all_stdout(compressed)

    } otherwise ready (command == "decode") {
        // Read compressed input from stdin
        sus compressed byte[] = io.read_all_stdin_bytes()

        // Decode - reversing the compression like a boss
        sus events Event[] = slay_decode(compressed)

        // Write JSON output
        sus writer ඞio.SlayWriter = io.new_stdout_writer()
        output_events_json(writer, events)
        writer.flush()

    } otherwise {
        vibez.spill("Unknown command: " + command)
        io.exit(1)
    }
}
