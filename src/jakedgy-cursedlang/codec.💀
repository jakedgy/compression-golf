    bestie i := 0; i < count; i = i + 1 {
        sus value thicc = 0
        bestie bit_idx := 0; bit_idx < bit_width; bit_idx = bit_idx + 1 {
            sus byte_idx normie = 1 + (bit_pos / 8)
            sus bit_in_byte normie = bit_pos % 8
            sus bit thicc = (thicc)((bytes[byte_idx] >> bit_in_byte) & 1)
            value = value | (bit << bit_idx)
            bit_pos = bit_pos + 1
        }
        values[i] = value
    }

    damn values
}

