        hpos = hpos + 1 fr fr skip null
    }

    fr fr Read name dictionary
    sus name_count normie = (normie)(slay_decode_varint(header, ඞhpos))
    sus names [tea]
    bestie i := 0; i < name_count; i = i + 1 {
        sus start normie = hpos
        bestie header[hpos] != 0 {
            hpos = hpos + 1
        }
        names = append(names, bytes_to_string(header[start:hpos]))
        hpos = hpos + 1
    }

    fr fr Read repo ID dictionary
    sus repo_count normie = (normie)(slay_decode_varint(header, ඞhpos))
    sus repo_ids [thicc] = make_thicc_array(repo_count)
    sus prev_id thicc = 0
    bestie i := 0; i < repo_count; i = i + 1 {
        sus delta thicc = slay_decode_varint(header, ඞhpos)
        repo_ids[i] = prev_id + delta
        prev_id = repo_ids[i]
    }

    fr fr Read name indices per repo ID
    sus name_indices_per_id [[normie]]
    bestie i := 0; i < repo_count; i = i + 1 {
        sus first_val thicc = slay_decode_varint(header, ඞhpos)
        lowkey first_val == 0 {
            fr fr Multi-name repo
            sus variant_count normie = (normie)(slay_decode_varint(header, ඞhpos))
            sus ni [normie] = make_normie_array(variant_count)
            bestie j := 0; j < variant_count; j = j + 1 {
                ni[j] = (normie)(slay_decode_varint(header, ඞhpos))
            }
            name_indices_per_id = append(name_indices_per_id, ni)
        } nah {
            fr fr Single-name repo (first_val is name_idx + 1)
            sus ni [normie] = [normie]{(normie)(first_val - 1)}
            name_indices_per_id = append(name_indices_per_id, ni)
        }
    }

    sus num_groups normie = (normie)(slay_decode_varint(header, ඞhpos))

    sus events [Event]

    fr fr Process row groups
    bestie group_idx := 0; group_idx < num_groups; group_idx = group_idx + 1 {
        sus min_id thicc = slay_decode_varint(bytes, ඞpos)
        sus min_ts thicc = slay_decode_varint(bytes, ඞpos)
        sus row_count normie = (normie)(slay_decode_varint(bytes, ඞpos))

        fr fr Read column sizes
        sus types_len normie = (normie)(slay_decode_varint(bytes, ඞpos))
        sus repo_idx_len normie = (normie)(slay_decode_varint(bytes, ඞpos))
        sus variant_idx_len normie = (normie)(slay_decode_varint(bytes, ඞpos))
        sus ids_len normie = (normie)(slay_decode_varint(bytes, ඞpos))
        sus ts_len normie = (normie)(slay_decode_varint(bytes, ඞpos))

        fr fr Read and decompress columns
        sus types_decompressed [byte] = zstd_decompress(bytes[pos:pos + types_len])
        pos = pos + types_len

        sus repo_idx_decompressed [byte] = zstd_decompress(bytes[pos:pos + repo_idx_len])
        pos = pos + repo_idx_len

        sus variant_idx_decompressed [byte] = zstd_decompress(bytes[pos:pos + variant_idx_len])
        pos = pos + variant_idx_len

        sus ids_decompressed [byte] = zstd_decompress(bytes[pos:pos + ids_len])
        pos = pos + ids_len

        sus ts_decompressed [byte] = zstd_decompress(bytes[pos:pos + ts_len])
        pos = pos + ts_len

        fr fr Unpack columns
        sus type_indices [thicc] = unpack_bits_slay(types_decompressed, row_count)
        sus repo_idx_values [thicc] = unpack_bits_slay(repo_idx_decompressed, row_count)
        sus variant_indices [thicc] = unpack_bits_slay(variant_idx_decompressed, row_count)
        sus id_deltas [thicc] = decode_id_deltas_slay(ids_decompressed)
        sus ts_deltas [thicc] = decode_ts_deltas_slay(ts_decompressed)

        fr fr Reconstruct IDs
        sus id_offsets [thicc] = make_thicc_array(row_count)
        lowkey row_count > 0 {
            sus cur thicc = zigzag_unslay(id_deltas[0])
            id_offsets[0] = cur
            bestie i := 1; i < row_count; i = i + 1 {
                cur = cur + zigzag_unslay(id_deltas[i])
                id_offsets[i] = cur
            }
        }

        fr fr Reconstruct timestamps
        sus ts_offsets [thicc] = make_thicc_array(row_count)
        lowkey row_count > 0 {
            sus cur_ts thicc = ts_deltas[0]
            ts_offsets[0] = cur_ts
            bestie i := 1; i < row_count; i = i + 1 {
                cur_ts = cur_ts + ts_deltas[i]
                ts_offsets[i] = cur_ts
            }
        }

        fr fr Create events
        bestie i := 0; i < row_count; i = i + 1 {
            sus type_idx normie = (normie)(type_indices[i])
            sus repo_idx normie = (normie)(repo_idx_values[i])
            sus variant_idx normie = (normie)(variant_indices[i])
            sus event_id thicc = min_id + id_offsets[i]
            sus timestamp thicc = min_ts + ts_offsets[i]

            sus repo_id thicc = repo_ids[repo_idx]
            sus name_idx normie = name_indices_per_id[repo_idx][variant_idx]
            sus repo_name tea = names[name_idx]
            sus repo_url tea = sprintf("https://api.github.com/repos/%s", repo_name)

            sus event Event
            event.id = sprintf("%d", event_id)
            event.event_type = types[type_idx]
            event.repo_id = repo_id
            event.repo_name = repo_name
            event.repo_url = repo_url
            event.created_at = format_timestamp_slay(timestamp)

            events = append(events, event)
        }
    }

    fr fr Sort by (id, event_type) as required
    sort_events_by_key(events)

    damn events
}

fr fr ============================================================================
fr fr OUTPUT JSON - spilling the tea back out bestie
fr fr ============================================================================

slay output_events_json(writer ඞSlayWriter, events [Event]) {
    bestie i := 0; i < len(events); i = i + 1 {
        sus e Event = events[i]
        sus line tea = sprintf("{\"id\":\"%s\",\"type\":\"%s\",\"repo\":{\"id\":%d,\"name\":\"%s\",\"url\":\"%s\"},\"created_at\":\"%s\"}\n",
            e.id, e.event_type, e.repo_id, e.repo_name, e.repo_url, e.created_at)
        writer.write_string(line)
    }
}

fr fr ============================================================================
fr fr MAIN - where the vibes come together no cap
fr fr ============================================================================

slay main() {
    sus args [tea] = get_args()

    lowkey len(args) != 2 {
        spill_err("Usage: codec <encode|decode>")
        exit(1)
    }

    sus command tea = args[1]

    lowkey command == "encode" {
        fr fr Read all input from stdin
        sus input tea = read_all_stdin()

        fr fr Parse events
        sus events [Event] = parse_json_events(input)

        fr fr Encode - let's get this compression bread
        sus compressed [byte] = slay_encode(events)

        fr fr Write to stdout
        write_all_stdout(compressed)

    } nah lowkey command == "decode" {
        fr fr Read compressed input from stdin
        sus compressed [byte] = read_all_stdin_bytes()

        fr fr Decode - reversing the compression like a boss
        sus events [Event] = slay_decode(compressed)

        fr fr Write JSON output
        sus writer ඞSlayWriter = new_stdout_writer()
        output_events_json(writer, events)
        writer.flush()

    } nah {
        spill_err("Unknown command: " + command)
        exit(1)
    }
}
