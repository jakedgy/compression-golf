slay pack_bits_slay(values [thicc]) [byte] {
    lowkey len(values) == 0 {
        damn [byte]{0}
    }

    sus max_val thicc = 0
    bestie i := 0; i < len(values); i = i + 1 {
        lowkey values[i] > max_val {
            max_val = values[i]
        }
    }

    sus bit_width normie = 1
    lowkey max_val != 0 {
        bit_width = 64 - count_leading_zeros(max_val)
    }

    sus total_bits normie = len(values) * bit_width
    sus byte_count normie = (total_bits + 7) / 8 + 1

    sus buf [byte] = make_byte_array(byte_count)
    buf[0] = (byte)(bit_width)

    sus bit_pos normie = 0
    bestie i := 0; i < len(values); i = i + 1 {
        sus value thicc = values[i]
        bestie bit_idx := 0; bit_idx < bit_width; bit_idx = bit_idx + 1 {
            sus bit byte = (byte)((value >> bit_idx) & 1)
            sus byte_idx normie = 1 + (bit_pos / 8)
            sus bit_in_byte normie = bit_pos % 8
            buf[byte_idx] = buf[byte_idx] | (bit << bit_in_byte)
            bit_pos = bit_pos + 1
        }
    }

    damn buf
}

slay unpack_bits_slay(bytes [byte], count normie) [thicc] {
    lowkey count == 0 {
