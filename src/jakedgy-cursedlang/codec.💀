fr fr ============================================================================
fr fr ENCODE - this is the main character moment frfr
fr fr ============================================================================

slay slay_encode(events [Event]) [byte] {
    sus type_dict TypeDict = build_type_dict(events)
    sus name_dict RepoNameDict = build_name_dict(events)
    sus id_dict RepoIdDict = build_id_dict(events, name_dict)

    fr fr Build header - this is where the slay begins
    sus header [byte]
    header = append(header, string_to_bytes(SLAY_MAGIC)...)
    header = append_varint(header, len(events))

    fr fr Type dictionary
    header = append_varint(header, len(type_dict.types))
    bestie i := 0; i < len(type_dict.types); i = i + 1 {
        header = append(header, string_to_bytes(type_dict.types[i])...)
        header = append(header, 0) fr fr null terminator
    }

    fr fr Name dictionary
    header = append_varint(header, len(name_dict.names))
    bestie i := 0; i < len(name_dict.names); i = i + 1 {
        header = append(header, string_to_bytes(name_dict.names[i])...)
        header = append(header, 0)
    }

    fr fr Repo ID dictionary with delta encoding
    header = append_varint(header, len(id_dict.repo_ids))
    sus prev_id thicc = 0
    bestie i := 0; i < len(id_dict.repo_ids); i = i + 1 {
        sus id thicc = id_dict.repo_ids[i]
        header = append_varint(header, id - prev_id)
        prev_id = id
    }

    fr fr Name indices per repo ID (with sentinel encoding)
    bestie i := 0; i < len(id_dict.repo_ids); i = i + 1 {
        sus names [normie] = id_dict.name_indices_per_id[i]
        lowkey len(names) == 1 {
            header = append_varint(header, names[0] + 1)
        } nah {
            header = append(header, 0)
            header = append_varint(header, len(names))
            bestie j := 0; j < len(names); j = j + 1 {
                header = append_varint(header, names[j])
            }
        }
    }

    fr fr Number of row groups
    sus num_groups normie = (len(events) + ROW_GROUP_VIBES - 1) / ROW_GROUP_VIBES
    header = append_varint(header, num_groups)

    fr fr Compress header with zstd - squishing it down fr
    sus header_compressed [byte] = zstd_compress(header, ZSTD_LEVEL)

    fr fr Build output
    sus output [byte]
    output = append_varint(output, len(header_compressed))
    output = append(output, header_compressed...)

    fr fr Process row groups - dividing the work like a responsible adult (rare)
    bestie group_idx := 0; group_idx < num_groups; group_idx = group_idx + 1 {
        sus start normie = group_idx * ROW_GROUP_VIBES
        sus end normie = min(start + ROW_GROUP_VIBES, len(events))
        sus slice [Event] = events[start:end]
        sus row_count normie = len(slice)

        fr fr Extract columns
        sus type_indices [byte] = make_byte_array(row_count)
        sus repo_idx_col [normie] = make_normie_array(row_count)
        sus variant_idx_col [normie] = make_normie_array(row_count)
        sus ids [thicc] = make_thicc_array(row_count)
        sus timestamps [thicc] = make_thicc_array(row_count)

        bestie i := 0; i < row_count; i = i + 1 {
            sus e Event = slice[i]
            type_indices[i] = (byte)(type_dict.type_to_idx[e.event_type])
            sus name_idx normie = name_dict.name_to_idx[e.repo_name]
            repo_idx_col[i] = id_dict.id_to_idx[e.repo_id]
            sus variant_key tea = sprintf("%d_%d", e.repo_id, name_idx)
            variant_idx_col[i] = id_dict.variant_lookup[variant_key]
            ids[i] = parse_thicc(e.id)
            timestamps[i] = parse_timestamp_slay(e.created_at)
        }

        fr fr Create permutation sorted by timestamp (for that temporal locality drip)
        sus perm [normie] = make_range(row_count)
        sort_by_key(perm, timestamps)

        fr fr Apply permutation
        sus sorted_types [thicc] = make_thicc_array(row_count)
        sus sorted_repo_idx [thicc] = make_thicc_array(row_count)
        sus sorted_variant_idx [thicc] = make_thicc_array(row_count)
        sus sorted_ids [thicc] = make_thicc_array(row_count)
        sus sorted_ts [thicc] = make_thicc_array(row_count)

        bestie i := 0; i < row_count; i = i + 1 {
            sus p normie = perm[i]
            sorted_types[i] = (thicc)(type_indices[p])
            sorted_repo_idx[i] = (thicc)(repo_idx_col[p])
            sorted_variant_idx[i] = (thicc)(variant_idx_col[p])
            sorted_ids[i] = ids[p]
            sorted_ts[i] = timestamps[p]
        }

        fr fr Find minimums
        sus min_id thicc = min_thicc(sorted_ids)
        sus min_ts thicc = min_thicc(sorted_ts)

        fr fr Convert to offsets
        bestie i := 0; i < row_count; i = i + 1 {
            sorted_ids[i] = sorted_ids[i] - min_id
            sorted_ts[i] = sorted_ts[i] - min_ts
        }

        fr fr Delta encode IDs with zigzag
        sus id_deltas [thicc] = make_thicc_array(row_count)
        lowkey row_count > 0 {
            sus prev thicc = sorted_ids[0]
            id_deltas[0] = zigzag_slay(prev)
            bestie i := 1; i < row_count; i = i + 1 {
                sus cur thicc = sorted_ids[i]
                id_deltas[i] = zigzag_slay(cur - prev)
                prev = cur
            }
        }

        fr fr Delta encode timestamps
        sus ts_deltas [thicc] = make_thicc_array(row_count)
        lowkey row_count > 0 {
            sus prev_ts thicc = sorted_ts[0]
            ts_deltas[0] = prev_ts
            bestie i := 1; i < row_count; i = i + 1 {
                ts_deltas[i] = sorted_ts[i] - prev_ts
                prev_ts = sorted_ts[i]
            }
        }

        fr fr Bit-pack and compress each column
        sus types_packed [byte] = pack_bits_slay(sorted_types)
        sus repo_idx_packed [byte] = pack_bits_slay(sorted_repo_idx)
        sus variant_idx_packed [byte] = pack_bits_slay(sorted_variant_idx)
        sus ids_packed [byte] = encode_id_deltas_slay(id_deltas)
        sus ts_packed [byte] = encode_ts_deltas_slay(ts_deltas)

        sus types_compressed [byte] = zstd_compress(types_packed, ZSTD_LEVEL)
        sus repo_idx_compressed [byte] = zstd_compress(repo_idx_packed, ZSTD_LEVEL)
        sus variant_idx_compressed [byte] = zstd_compress(variant_idx_packed, ZSTD_LEVEL)
        sus ids_compressed [byte] = zstd_compress(ids_packed, ZSTD_LEVEL)
        sus ts_compressed [byte] = zstd_compress(ts_packed, ZSTD_LEVEL)

        fr fr Write row group header
        output = append_varint(output, min_id)
        output = append_varint(output, min_ts)
        output = append_varint(output, row_count)

        fr fr Write column sizes
        output = append_varint(output, len(types_compressed))
        output = append_varint(output, len(repo_idx_compressed))
        output = append_varint(output, len(variant_idx_compressed))
        output = append_varint(output, len(ids_compressed))
        output = append_varint(output, len(ts_compressed))

        fr fr Write column data
        output = append(output, types_compressed...)
        output = append(output, repo_idx_compressed...)
        output = append(output, variant_idx_compressed...)
        output = append(output, ids_compressed...)
        output = append(output, ts_compressed...)
    }

    damn output
}

